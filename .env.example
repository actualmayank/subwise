# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/subwise?schema=public"

# Auth.js secret — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-random-secret"

# Google OAuth client — create at https://console.cloud.google.com/auth/clients
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
AUTH_GOOGLE_ID="replace-with-your-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-your-google-client-secret"
